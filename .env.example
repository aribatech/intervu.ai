# Copy to .env and fill in. Never commit .env.

# OpenAI - the interview "brain"
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# ElevenLabs - realtime voice agent (Conversational AI)
# The key MUST have "ElevenAgents" (Conversational AI) = Write, plus TTS access.
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_AGENT_ID=            # created once via: python -m app.setup_agent
ELEVENLABS_AGENT_LLM=gpt-4.1
ELEVENLABS_TTS_MODEL=eleven_turbo_v2_5
ELEVENLABS_STT_MODEL=scribe_v1

# App + sessions
APP_NAME=Verbal AI Interviewer
SECRET_KEY=change-me-to-a-long-random-string   # signs login session cookies

# Email (SMTP). Leave SMTP_HOST empty to just log emails to the console (dev).
# Works with Gmail App Password, SendGrid, Mailgun, Postmark, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
EMAIL_FROM=no-reply@example.com

# Public base URL used to build candidate join links (no trailing slash).
# Use your real host in production, e.g. https://interviews.yourdomain.com
PUBLIC_BASE_URL=http://127.0.0.1:8000

# How long a created interview link stays joinable (minutes)
INTERVIEW_TTL_MINUTES=1440

# Database (async SQLAlchemy URL)
DATABASE_URL=sqlite+aiosqlite:///./mockpilot.db
